function rollChestPrize() {
  const r = Math.random();
  if (r < 0.01) return { tier: 'legendary', coins: 1000, emoji: '👑', name: 'ЛЕГЕНДАРНЫЙ' };
  if (r < 0.10) return { tier: 'epic', coins: 300 + Math.floor(Math.random() * 200), emoji: '💎', name: 'ЭПИЧЕСКИЙ' };
  if (r < 0.40) return { tier: 'rare', coins: 100 + Math.floor(Math.random() * 100), emoji: '💠', name: 'РЕДКИЙ' };
  return { tier: 'common', coins: 20 + Math.floor(Math.random() * 30), emoji: '💰', name: 'ОБЫЧНЫЙ' };
}

function openChest() {
  if ($('openChestBtn').disabled) return;
  const today = new Date().toISOString().slice(0, 10);
  if (lastChestDate === today) return;

  const emoji = $('chestEmoji');
  const prizeEl = $('chestPrize');
  const btn = $('openChestBtn');
  const info = $('chestInfo');

  btn.disabled = true;
  btn.textContent = 'Открывается...';
  emoji.classList.add('shaking');
  playEatSound();

  setTimeout(function() {
    const prize = rollChestPrize();
    emoji.classList.remove('shaking');
    emoji.classList.add('burst');
    playChestOpenSound();

    setTimeout(function() {
      emoji.textContent = '📭';
      emoji.className = '';

      wallet += prize.coins;
      lastChestDate = today;
      localStorage.setItem('snake_chestDate', today);
      saveProgress(); updateWalletUI(); pulseWallet();
      if (prize.tier === 'legendary') playVictorySound();
      else playCoinSound();

      prizeEl.innerHTML =
        '<div class="prizeEmoji">' + prize.emoji + '</div>' +
        '<div class="prizeText rarity-' + prize.tier + '">' + prize.name + '</div>' +
        '<div class="prizeAmount rarity-' + prize.tier + '">+' + prize.coins + ' 🍎</div>';
      info.textContent = 'Приходи завтра!';
      btn.textContent = '✓ Готово';
    }, 500);
  }, 1400);
}

function renderGoals() {
  const g = getGoal();
  const done = g.progress >= g.target;
  const percent = Math.min(100, (g.progress / g.target) * 100);
  let html = '<div class="goalCard">' +
    '<div class="goalTitle">Сегодняшняя цель</div>' +
    '<div class="goalDesc">🍎 Собери ' + g.target + ' яблок</div>' +
    '<div class="goalBar"><div class="goalBarFill" style="width:' + percent + '%"></div></div>' +
    '<div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text-dim)">' +
    '<span>' + Math.min(g.progress, g.target) + ' / ' + g.target + '</span>' +
    '<span class="goalReward">+' + g.reward + ' 🍎</span></div></div>';
  if (done && !g.claimed) {
    html += '<button class="action" id="claimGoal" style="width:100%;margin-top:10px">🎁 Забрать ' + g.reward + ' 🍎</button>';
  } else if (g.claimed) {
    html += '<div class="goalDone">✓ Цель выполнена! Возвращайся завтра</div>';
  } else {
    html += '<div style="text-align:center;color:var(--text-dim);font-size:13px;margin-top:10px">Собери ещё ' + (g.target - g.progress) + ' яблок</div>';
  }
  $('goalsContent').innerHTML = html;
  const btn = $('claimGoal');
  if (btn) btn.addEventListener('click', function() {
    const g2 = getGoal();
    if (g2.progress >= g2.target && !g2.claimed) {
      wallet += g2.reward;
      g2.claimed = true;
      saveGoal(g2);
      saveProgress(); updateWalletUI(); pulseWallet();
      playVictorySound();
      showToast('🎁 +' + g2.reward + ' 🍎');
      renderGoals();
    }
  });
}

