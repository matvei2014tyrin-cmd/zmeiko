let currentBet = 25;
let casinoSpinning = false;

const SLOT_SYMBOLS = [
  { emoji: '🍎', weight: 30, multiplier: 2 },
  { emoji: '🍋', weight: 25, multiplier: 3 },
  { emoji: '🍇', weight: 20, multiplier: 5 },
  { emoji: '🔔', weight: 12, multiplier: 10 },
  { emoji: '💎', weight: 8, multiplier: 20 },
  { emoji: '7️⃣', weight: 4, multiplier: 50 },
  { emoji: '👑', weight: 1, multiplier: 100 }
];

function weightedRandomSymbol() {
  let total = 0;
  for (let i = 0; i < SLOT_SYMBOLS.length; i++) total += SLOT_SYMBOLS[i].weight;
  let r = Math.random() * total;
  for (let i = 0; i < SLOT_SYMBOLS.length; i++) {
    if (r < SLOT_SYMBOLS[i].weight) return SLOT_SYMBOLS[i];
    r -= SLOT_SYMBOLS[i].weight;
  }
  return SLOT_SYMBOLS[0];
}

function spinCasino() {
  if (casinoSpinning) return;
  if (wallet < currentBet) { showToast('Не хватает 🍎'); return; }

  casinoSpinning = true;
  wallet -= currentBet;
  saveProgress(); updateWalletUI();
  playEatSound();

  const reels = [$('reel1'), $('reel2'), $('reel3')];
  for (let i = 0; i < reels.length; i++) {
    reels[i].classList.remove('win');
    reels[i].classList.add('spinning');
  }
  $('spinCasinoBtn').disabled = true;
  $('slotResult').textContent = '';
  $('slotResult').className = '';

  const interval = setInterval(function() {
    for (let i = 0; i < reels.length; i++) reels[i].textContent = weightedRandomSymbol().emoji;
  }, 80);

  const final1 = weightedRandomSymbol();
  const final2 = weightedRandomSymbol();
  const final3 = weightedRandomSymbol();

  setTimeout(function() {
    reels[0].classList.remove('spinning');
    reels[0].textContent = final1.emoji;
    playTone(500, 'square', 0.1, 0.1);
  }, 700);
  setTimeout(function() {
    reels[1].classList.remove('spinning');
    reels[1].textContent = final2.emoji;
    playTone(500, 'square', 0.1, 0.1);
  }, 1200);
  setTimeout(function() {
    clearInterval(interval);
    reels[2].classList.remove('spinning');
    reels[2].textContent = final3.emoji;

    let win = 0;
    let msg = '';
    let isBigWin = false;

    if (final1.emoji === final2.emoji && final2.emoji === final3.emoji) {
      win = currentBet * final1.multiplier;
      msg = '🎉 ДЖЕКПОТ! ×' + final1.multiplier + ' = +' + win + ' 🍎';
      isBigWin = true;
      for (let i = 0; i < reels.length; i++) reels[i].classList.add('win');
      playVictorySound();
      stats.casinoWins++;
      if (win > stats.casinoBiggest) stats.casinoBiggest = win;
    } else if (final1.emoji === final2.emoji || final2.emoji === final3.emoji || final1.emoji === final3.emoji) {
      win = Math.round(currentBet * 1.5);
      msg = '✨ Пара! +' + win + ' 🍎';
      playCoinSound();
    } else {
      msg = '😢 Не повезло. −' + currentBet + ' 🍎';
      playGameOverSound();
    }

    if (win > 0) {
      wallet += win;
      saveProgress(); updateWalletUI(); pulseWallet();
    }
    const resEl = $('slotResult');
    resEl.textContent = msg;
    if (isBigWin) resEl.className = 'bigwin';
    else if (win === 0) resEl.className = 'lose';
    else resEl.className = '';

    $('spinCasinoBtn').disabled = false;
    casinoSpinning = false;
    checkAchievements();
  }, 1800);
}

