function spawnGoldenApple() {
  let pos, tries = 0;
  do {
    pos = { x: Math.floor(Math.random() * COLS), y: Math.floor(Math.random() * ROWS) };
    tries++; if (tries > 200) return;
  } while (
    (food && pos.x === food.x && pos.y === food.y) ||
    (goldenApple && pos.x === goldenApple.x && pos.y === goldenApple.y) ||
    snake.some(function(s) { return s.x === pos.x && s.y === pos.y; })
  );
  goldenApple = { x: pos.x, y: pos.y, expiresAt: Date.now() + GOLDEN_LIFETIME };
  playGoldenAppearSound();
  showToast('🌟 Золотое яблоко!');
}
function activateFever() {
  feverActive = true; feverEndTime = Date.now() + FEVER_DURATION;
  nextFeverTime = feverEndTime + FEVER_COOLDOWN;
  playFeverStartSound(); showToast('⚡ ЛИХОРАДКА ×2!');
}
function updateEventBanner(now) {
  if (currentMode === 'sprint') {
    const sec = Math.max(0, Math.ceil((sprintEndTime - now) / 1000));
    eventBanner.className = 'show ' + (sec <= 10 ? 'fever' : 'golden');
    eventBanner.textContent = '⏱️ ' + sec + 'с • 🍎 ' + sprintApples + '/' + SPRINT_MIN;
    return;
  }
  if (currentMode === 'marathon') {
    eventBanner.className = 'show golden';
    eventBanner.textContent = '🏆 Длина: ' + snake.length + '/' + MARATHON_TARGET;
    return;
  }
  if (feverActive) {
    const sec = Math.max(0, Math.ceil((feverEndTime - now) / 1000));
    eventBanner.className = 'show fever';
    eventBanner.textContent = '⚡ ×2 — ' + sec + 'с';
  } else if (goldenApple) {
    const sec = Math.max(0, Math.ceil((goldenApple.expiresAt - now) / 1000));
    eventBanner.className = 'show golden';
    eventBanner.textContent = '🌟 Золотое! ' + sec + 'с';
  } else {
    eventBanner.className = ''; eventBanner.textContent = '';
  }
}

function reset() {
  initAudio();
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
  snake = [{x: 5, y: 5}, {x: 4, y: 5}, {x: 3, y: 5}];
  direction = {x: 1, y: 0}; nextDirection = {x: 1, y: 0};
  food = randomFood();
  running = true; modeFinished = false;
  overlay.classList.remove('show');
  clearInterval(timer);
  timer = setInterval(tick, 110);
  musicPaused = false;
  goldenApple = null; appleCount = 0;
  feverActive = false; feverEndTime = 0;
  nextFeverTime = Date.now() + FEVER_FIRST_DELAY;
  eventBanner.className = ''; eventBanner.textContent = '';
  sprintApples = 0; particles = []; snakeShakeUntil = 0;
  if (currentMode === 'sprint') sprintEndTime = Date.now() + SPRINT_TIME;
  startMusic();
  draw();
}
function randomFood() {
  let pos;
  do { pos = { x: Math.floor(Math.random() * COLS), y: Math.floor(Math.random() * ROWS) }; }
  while (snake && snake.some(function(s) { return s.x === pos.x && s.y === pos.y; }) ||
    (goldenApple && pos.x === goldenApple.x && pos.y === goldenApple.y));
  return pos;
}
function setDirection(dx, dy) {
  if (!running) return;
  if (direction.x === -dx && direction.y === -dy) return;
  if (direction.x === dx && direction.y === dy) return;
  nextDirection = {x: dx, y: dy};
}
function tick() {
  if (!running) return;
  const now = Date.now();

  if (!modeFinished) {
    if (currentMode === 'sprint' && now >= sprintEndTime) return endMode(sprintApples >= SPRINT_MIN);
    if (currentMode === 'marathon' && snake.length >= MARATHON_TARGET) return endMode(true);
  }

  if (currentMode === 'normal') {
    if (!feverActive && now >= nextFeverTime && appleCount >= 3) activateFever();
    if (feverActive && now >= feverEndTime) feverActive = false;
    if (goldenApple && now >= goldenApple.expiresAt) goldenApple = null;
  }
  updateEventBanner(now);
  updateParticles();

  direction = nextDirection;
  let head = { x: snake[0].x + direction.x, y: snake[0].y + direction.y };

  if (WRAP_WALLS) {
    head.x = (head.x + COLS) % COLS;
    head.y = (head.y + ROWS) % ROWS;
  } else {
    if (head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS) {
      if (currentMode !== 'normal') return endMode(false);
      return gameOver();
    }
  }
  if (DIE_ON_SELF && snake.some(function(s) { return s.x === head.x && s.y === head.y; })) {
    if (currentMode !== 'normal') return endMode(false);
    return gameOver();
  }

  snake.unshift(head);

  if (head.x === food.x && head.y === food.y) {
    const reward = (currentMode === 'normal' && feverActive) ? FEVER_MULTIPLIER : 1;
    wallet += reward;
    if (currentMode === 'sprint') sprintApples++;
    appleCount++;
    stats.totalApples++;
    addGoalProgress(1);
    saveProgress(); updateWalletUI(); pulseWallet();
    playEatSound(); playCoinSound();
    spawnParticles(head.x * CELL + CELL/2, head.y * CELL + CELL/2, '#fbbf24', 8);
    food = randomFood();
    if (currentMode === 'normal' && appleCount > 0 && appleCount % APPLES_FOR_GOLDEN === 0) spawnGoldenApple();
  } else {
    snake.pop();
  }

  if (goldenApple && head.x === goldenApple.x && head.y === goldenApple.y) {
    wallet += GOLDEN_APPLE_VALUE;
    saveProgress(); updateWalletUI(); pulseWallet();
    playGoldenSound();
    spawnParticles(head.x * CELL + CELL/2, head.y * CELL + CELL/2, '#fbbf24', 20);
    showToast('🌟 +' + GOLDEN_APPLE_VALUE + ' 🍎');
    goldenApple = null;
  }

  if (currentMode === 'normal' && snake.length > stats.bestNormal) stats.bestNormal = snake.length;
  if (currentMode === 'marathon' && snake.length > stats.bestMarathonLen) stats.bestMarathonLen = snake.length;

  draw();
}

function drawWallpaper() {
  const isLight = document.body.getAttribute('data-theme') === 'light';
  if (wallpaper === 'stars') {
    ctx.fillStyle = isLight ? '#e8ecff' : '#0a0a1e';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < 60; i++) {
      const x = (i * 73) % canvas.width;
      const y = (i * 137) % canvas.height;
      const r = (i % 3) * 0.5 + 0.5;
      ctx.fillStyle = 'rgba(' + (isLight ? '80,80,160' : '255,255,255') + ',' + (0.3 + (i % 5) * 0.12) + ')';
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    }
  } else if (wallpaper === 'chess') {
    for (let y = 0; y < ROWS; y++) for (let x = 0; x < COLS; x++) {
      if ((x + y) % 2 === 0) {
        ctx.fillStyle = isLight ? 'rgba(0,0,0,0.05)' : 'rgba(255,255,255,0.03)';
        ctx.fillRect(x * CELL, y * CELL, CELL, CELL);
      }
    }
  } else if (wallpaper === 'dots') {
    for (let y = 0; y < ROWS; y++) for (let x = 0; x < COLS; x++) {
      ctx.fillStyle = isLight ? 'rgba(80,80,160,0.18)' : 'rgba(255,255,255,0.1)';
      ctx.beginPath();
      ctx.arc(x * CELL + CELL/2, y * CELL + CELL/2, 1.5, 0, Math.PI * 2);
      ctx.fill();
    }
  } else if (wallpaper === 'gradient') {
    const g = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
    if (isLight) { g.addColorStop(0, '#f0f4ff'); g.addColorStop(1, '#e8e0ff'); }
    else { g.addColorStop(0, '#0f0f2e'); g.addColorStop(1, '#2e1a4e'); }
    ctx.fillStyle = g; ctx.fillRect(0, 0, canvas.width, canvas.height);
  }
}

function draw() {
  const skin = skins[currentSkin];
  const isLight = document.body.getAttribute('data-theme') === 'light';
  const canvasBg = isLight ? '#f8f9ff' : (document.body.getAttribute('data-theme') === 'neon' ? '#02020a' : '#0f0f1e');
  ctx.fillStyle = canvasBg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  drawWallpaper();

  if (feverActive && currentMode === 'normal') {
    ctx.fillStyle = 'rgba(251, 146, 60, 0.08)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }
  if (currentMode === 'sprint') { ctx.fillStyle = 'rgba(251, 191, 36, 0.05)'; ctx.fillRect(0, 0, canvas.width, canvas.height); }
  if (currentMode === 'marathon') { ctx.fillStyle = 'rgba(192, 132, 252, 0.06)'; ctx.fillRect(0, 0, canvas.width, canvas.height); }

  ctx.strokeStyle = isLight ? 'rgba(0,0,0,0.04)' : skin.grid;
  if (wallpaper !== 'chess' && wallpaper !== 'gradient') {
    for (let i = 1; i < COLS; i++) {
      ctx.beginPath(); ctx.moveTo(i * CELL, 0); ctx.lineTo(i * CELL, canvas.height); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, i * CELL); ctx.lineTo(canvas.width, i * CELL); ctx.stroke();
    }
  }

  ctx.font = '18px serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText(skin.food, food.x * CELL + CELL/2, food.y * CELL + CELL/2 + 1);

  if (goldenApple) drawGoldenApple(goldenApple.x * CELL + CELL/2, goldenApple.y * CELL + CELL/2);

  const trailColor = skin.trail;
  if (trailColor) {
    for (let i = 1; i < snake.length; i++) {
      const s = snake[i];
      const t = i / snake.length;
      const alpha = (1 - t) * 0.4;
      let color;
      if (trailColor === 'rainbow') {
        color = rainbowColor(t).replace('rgb', 'rgba').replace(')', ',' + alpha + ')');
      } else if (trailColor.indexOf('rgba') === 0) {
        color = trailColor.replace(/[\d.]+\)$/, alpha + ')');
      } else {
        color = trailColor;
      }
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(s.x * CELL + CELL/2, s.y * CELL + CELL/2, CELL * 0.6, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  let shakeX = 0, shakeY = 0;
  if (Date.now() < snakeShakeUntil) {
    shakeX = (Math.random() - 0.5) * 6;
    shakeY = (Math.random() - 0.5) * 6;
  }
  ctx.save();
  ctx.translate(shakeX, shakeY);

  const total = snake.length;
  for (let i = 0; i < snake.length; i++) {
    const s = snake[i];
    let color;
    if (i === 0) color = skin.head;
    else if (skin.bodyA === 'rainbow') color = rainbowColor(i / total);
    else {
      const t = i / total;
      const r1 = skin.bodyA[0], g1 = skin.bodyA[1], b1 = skin.bodyA[2];
      const r2 = skin.bodyB[0], g2 = skin.bodyB[1], b2 = skin.bodyB[2];
      color = 'rgb(' + Math.round(r1 + (r2 - r1) * t) + ',' + Math.round(g1 + (g2 - g1) * t) + ',' + Math.round(b1 + (b2 - b1) * t) + ')';
    }
    if (skin.striped && i > 0 && i % 2 === 0) color = '#1a1a1a';
    ctx.fillStyle = color;
    ctx.fillRect(s.x * CELL + 1, s.y * CELL + 1, CELL - 2, CELL - 2);
  }

  const h = snake[0];
  ctx.fillStyle = isLight ? '#0f0f1e' : skin.eyes;
  const eyeSize = 3;
  const cx = h.x * CELL + CELL/2, cy = h.y * CELL + CELL/2;
  let ex1, ey1, ex2, ey2;
  if (direction.x === 1) { ex1 = cx + 3; ey1 = cy - 4; ex2 = cx + 3; ey2 = cy + 4; }
  else if (direction.x === -1) { ex1 = cx - 3; ey1 = cy - 4; ex2 = cx - 3; ey2 = cy + 4; }
  else if (direction.y === 1) { ex1 = cx - 4; ey1 = cy + 3; ex2 = cx + 4; ey2 = cy + 3; }
  else { ex1 = cx - 4; ey1 = cy - 3; ex2 = cx + 4; ey2 = cy - 3; }
  ctx.fillRect(ex1 - eyeSize/2, ey1 - eyeSize/2, eyeSize, eyeSize);
  ctx.fillRect(ex2 - eyeSize/2, ey2 - eyeSize/2, eyeSize, eyeSize);
  ctx.restore();

  for (let i = 0; i < particles.length; i++) {
    const p = particles[i];
    ctx.globalAlpha = p.life;
    ctx.fillStyle = p.color;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
  }
  ctx.globalAlpha = 1;
}

function drawGoldenApple(cx, cy) {
  const grad = ctx.createRadialGradient(cx, cy, 2, cx, cy, 20);
  grad.addColorStop(0, 'rgba(251, 191, 36, 0.85)');
  grad.addColorStop(0.5, 'rgba(251, 191, 36, 0.3)');
  grad.addColorStop(1, 'rgba(251, 191, 36, 0)');
  ctx.fillStyle = grad;
  ctx.beginPath(); ctx.arc(cx, cy, 20, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#fbbf24';
  ctx.beginPath(); ctx.arc(cx, cy + 1, 7, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#fef3c7';
  ctx.beginPath(); ctx.arc(cx - 2, cy - 2, 2, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = '#78350f'; ctx.lineWidth = 1.5;
  ctx.beginPath(); ctx.moveTo(cx, cy - 6); ctx.lineTo(cx + 1, cy - 9); ctx.stroke();
  ctx.fillStyle = '#4ade80';
  ctx.beginPath();
  ctx.ellipse(cx + 3, cy - 8, 2.5, 1.5, Math.PI / 4, 0, Math.PI * 2);
  ctx.fill();
}

function gameOver() {
  running = false;
  clearInterval(timer);
  stopMusic();
  playGameOverSound();
  snakeShakeUntil = Date.now() + 400;
  goldenApple = null; feverActive = false;
  eventBanner.className = ''; eventBanner.textContent = '';
  stats.games++; saveProgress();
  checkAchievements();
  overlayText.innerHTML = 'Игра окончена!<br>' +
    '<b style="color:#fbbf24;font-size:24px">🍎 ' + wallet + '</b><br>' +
    '<span style="color:#888;font-size:13px">Длина: ' + snake.length + '</span>';
  overlay.classList.add('show');
  draw();
}

function endMode(success) {
  if (modeFinished) return;
  modeFinished = true; running = false;
  clearInterval(timer); stopMusic();
  goldenApple = null; feverActive = false;
  eventBanner.className = ''; eventBanner.textContent = '';

  let reward = 0, title = '', subtitle = '';
  if (currentMode === 'sprint') {
    if (success) {
      const extra = Math.max(0, sprintApples - SPRINT_MIN);
      reward = SPRINT_BASE_REWARD + extra * SPRINT_PER_EXTRA;
      title = '🏁 СПРИНТ ПРОЙДЕН!';
      subtitle = 'Яблок: ' + sprintApples + ' (мин. ' + SPRINT_MIN + ')';
      stats.sprintWins++;
      if (sprintApples > stats.bestSprintApples) stats.bestSprintApples = sprintApples;
      playVictorySound();
    } else {
      reward = sprintApples * SPRINT_LOSS_PER_APPLE;
      title = '⏱️ Время вышло!';
      subtitle = 'Яблок: ' + sprintApples + ' (нужно ' + SPRINT_MIN + ')';
      playGameOverSound();
    }
  } else if (currentMode === 'marathon') {
    if (success) {
      reward = MARATHON_REWARD;
      title = '🏆 МАРАФОН ПРОЙДЕН!';
      subtitle = 'Длина: ' + snake.length;
      stats.marathonWins++;
      playVictorySound();
    } else {
      reward = Math.max(0, (snake.length - 3) * MARATHON_LOSS_PER_LEN);
      title = '💥 Разбился!';
      subtitle = 'Длина: ' + snake.length + ' из ' + MARATHON_TARGET;
      playGameOverSound();
    }
  }

  stats.games++;
  if (reward > 0) { wallet += reward; saveProgress(); updateWalletUI(); setTimeout(playCoinSound, 300); }
  checkAchievements();

  if (success) {
    for (let i = 0; i < 40; i++) {
      (function(i) {
        setTimeout(function() {
          const x = Math.random() * canvas.width;
          const y = Math.random() * canvas.height * 0.6;
          const colors = ['#fbbf24', '#4ade80', '#22d3ee', '#ec4899', '#a855f7'];
          spawnParticles(x, y, colors[Math.floor(Math.random() * colors.length)], 8);
        }, i * 25);
      })(i);
    }
    draw();
    const gw = $('gameWrap');
    gw.classList.add('victory-glow');
    setTimeout(function() { gw.classList.remove('victory-glow'); }, 2500);
  }

  overlayText.innerHTML = title + '<br>' +
    '<span style="font-size:13px;color:#aaa">' + subtitle + '</span><br><br>' +
    '<b style="color:#fbbf24;font-size:28px">+' + reward + ' 🍎</b><br>' +
    '<span style="color:#888;font-size:12px">Всего: ' + wallet + ' 🍎</span>';
  overlay.classList.add('show');
}

