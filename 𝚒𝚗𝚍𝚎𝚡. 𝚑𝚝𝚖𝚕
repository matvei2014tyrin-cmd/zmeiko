  updateDailyBtn();
  shopGrid.innerHTML = '';
  for (let idx = 0; idx < skins.length; idx++) {
    (function(idx) {
      const skin = skins[idx];
      const owned = unlockedSkins.indexOf(idx) !== -1;
      const equipped = currentSkin === idx;
      const canAfford = wallet >= skin.cost;
      const card = document.createElement('div');
      card.className = 'skinCard ' + (equipped ? 'equipped' : owned ? 'owned' : 'locked');
      if (skin.mythic) card.classList.add('mythic');
      const preview = document.createElement('div');
      preview.className = 'skinPreview';
      if (owned) {
        preview.style.background = getSkinGradient(skin);
        preview.textContent = skin.food;
      } else {
        preview.style.background = 'var(--bg-input)';
        preview.textContent = '🔒';
      }
      card.appendChild(preview);
      const name = document.createElement('div');
      name.className = 'skinName';
      name.textContent = skin.name;
      if (skin.mythic) name.style.color = '#fbbf24';
      card.appendChild(name);
      const status = document.createElement('div');
      if (equipped) { status.className = 'skinStatus equipped'; status.textContent = '✓ Надет'; }
      else if (owned) { status.className = 'skinStatus owned'; status.textContent = 'Надеть'; }
      else if (canAfford) {
        status.className = skin.mythic ? 'skinStatus mythic' : 'skinStatus buyable';
        status.textContent = 'Купить ' + skin.cost + ' 🍎';
      }
      else { status.className = 'skinStatus locked'; status.textContent = skin.cost + ' 🍎'; }
      card.appendChild(status);
      if (!owned && canAfford && skin.cost > 0) {
        const badge = document.createElement('div');
        badge.className = skin.mythic ? 'cardBadge mythic' : 'cardBadge';
        badge.textContent = skin.mythic ? 'ЛЮКС' : 'КУПИТЬ';
        card.appendChild(badge);
      }
      card.addEventListener('click', function() { handleSkinClick(idx); });
      shopGrid.appendChild(card);
    })(idx);
  }
}
function handleSkinClick(idx) {
  const skin = skins[idx];
  const owned = unlockedSkins.indexOf(idx) !== -1;
  const canAfford = wallet >= skin.cost;
  if (owned) {
    currentSkin = idx; saveProgress(); applySkinAccent(); playCoinSound(); renderShop();
    return;
  }
  if (canAfford) {
    wallet -= skin.cost;
    unlockedSkins.push(idx);
    currentSkin = idx;
    saveProgress(); applySkinAccent(); updateWalletUI(); playCoinSound();
    showToast('✓ Куплен «' + skin.name + '»!');
    checkAchievements();
    renderShop();
  } else {
    playGameOverSound();
    showToast('Не хватает ' + (skin.cost - wallet) + ' 🍎');
    const card = shopGrid.children[idx];
    card.animate([
      { transform: 'translateX(0)' }, { transform: 'translateX(-6px)' },
      { transform: 'translateX(6px)' }, { transform: 'translateX(-6px)' },
      { transform: 'translateX(0)' }
    ], { duration: 300 });
  }
}

