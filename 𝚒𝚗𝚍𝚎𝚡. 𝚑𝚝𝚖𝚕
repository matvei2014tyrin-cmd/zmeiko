function drawWheel() {
  const wc = $('wheel');
  const wctx = wc.getContext('2d');
  const cx = 140, cy = 140, r = 130;
  const colors = ['#4ade80', '#22d3ee', '#a855f7', '#fbbf24', '#ec4899', '#f97316', '#3b82f6', '#10b981'];
  const n = wheelPrizes.length;
  wctx.clearRect(0, 0, 280, 280);
  for (let i = 0; i < n; i++) {
    const a0 = (i / n) * Math.PI * 2 - Math.PI / 2;
    const a1 = ((i + 1) / n) * Math.PI * 2 - Math.PI / 2;
    wctx.beginPath();
    wctx.moveTo(cx, cy);
    wctx.arc(cx, cy, r, a0, a1);
    wctx.closePath();
    wctx.fillStyle = colors[i % colors.length];
    wctx.fill();
    wctx.strokeStyle = '#1a1a2e'; wctx.lineWidth = 3; wctx.stroke();
    const mid = (a0 + a1) / 2;
    const tx = cx + Math.cos(mid) * r * 0.72;
    const ty = cy + Math.sin(mid) * r * 0.72;
    wctx.save();
    wctx.translate(tx, ty);
    wctx.rotate(mid + Math.PI / 2);
    wctx.fillStyle = '#1a1a2e';
    wctx.font = 'bold 18px system-ui';
    wctx.textAlign = 'center'; wctx.textBaseline = 'middle';
    wctx.fillText(wheelPrizes[i], 0, 0);
    wctx.restore();
  }
  wctx.beginPath(); wctx.arc(cx, cy, 22, 0, Math.PI * 2);
  wctx.fillStyle = '#1a1a2e'; wctx.fill();
  wctx.strokeStyle = '#fbbf24'; wctx.lineWidth = 3; wctx.stroke();
}
function spinWheel() {
  if (wheelSpinning) return;
  const today = new Date().toISOString().slice(0, 10);
  if (lastWheelDate === today) { showToast('🎰 Уже крутил сегодня'); return; }
  wheelSpinning = true;
  $('spinBtn').disabled = true;
  const idx = Math.floor(Math.random() * wheelPrizes.length);
  const n = wheelPrizes.length;
  const targetAngle = -(idx + 0.5) * (360 / n) - 90;
  const extra = 360 * 4;
  $('wheel').style.transform = 'rotate(' + (extra + targetAngle) + 'deg)';
  setTimeout(function() {
    const prize = wheelPrizes[idx];
    wallet += prize;
    lastWheelDate = today;
    localStorage.setItem('snake_wheelDate', today);
    saveProgress(); updateWalletUI(); pulseWallet();
    playVictorySound();
    $('spinResult').textContent = '🎉 +' + prize + ' 🍎';
    $('spinBtn').textContent = '✓ Приходи завтра';
    wheelSpinning = false;
  }, 4100);
}
function updateWheelUI() {
  const today = new Date().toISOString().slice(0, 10);
  const btn = $('spinBtn');
  if (lastWheelDate === today) {
    btn.disabled = true;
