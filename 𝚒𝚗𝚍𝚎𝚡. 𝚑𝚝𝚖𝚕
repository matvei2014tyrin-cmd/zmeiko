let currentSkin = parseInt(localStorage.getItem('snake_skin')) || 0;
let stats = JSON.parse(localStorage.getItem('snake_stats')) || {
  games: 0, bestNormal: 0, totalApples: 0, sprintWins: 0, marathonWins: 0,
  bestSprintApples: 0, bestMarathonLen: 0, casinoWins: 0, casinoBiggest: 0
};
if (stats.casinoWins === undefined) stats.casinoWins = 0;
if (stats.casinoBiggest === undefined) stats.casinoBiggest = 0;
let achievements = JSON.parse(localStorage.getItem('snake_achievements')) || {};
let wallpaper = localStorage.getItem('snake_wallpaper') || 'classic';
let themeMode = localStorage.getItem('snake_themeMode') || 'dark';
let customMelody = JSON.parse(localStorage.getItem('snake_melody')) || [0,0,0,0,0,0,0,0];
let lastWheelDate = localStorage.getItem('snake_wheelDate') || '';
let lastChestDate = localStorage.getItem('snake_chestDate') || '';
let customAccent = localStorage.getItem('snake_customAccent') || '';

const themeIcons = { dark: '🌙', light: '☀️', neon: '⚡', auto: '🔄' };
const themeOrder = ['dark', 'light', 'neon', 'auto'];

function computeAutoTheme() {
  const h = new Date().getHours();
