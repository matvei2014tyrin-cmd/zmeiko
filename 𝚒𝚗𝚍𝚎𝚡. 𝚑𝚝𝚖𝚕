<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Змейка</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  :root {
    --bg-main: #1a1a2e; --bg-deep: #14142a; --bg-card: #252547; --bg-card-light: #2a2a4a;
    --bg-input: #0f0f1e; --border: #3b3b6b; --border-soft: #2a2a45;
    --text: #eeeeee; --text-dim: #888888; --text-more-dim: #666666;
    --accent: #4ade80; --shadow: rgba(0, 0, 0, 0.35); --canvas-bg: #0f0f1e;
  }
  body[data-theme="light"] {
    --bg-main: #eef0f8; --bg-deep: #e0e3f0; --bg-card: #ffffff; --bg-card-light: #f8f9ff;
    --bg-input: #f0f2f8; --border: #c8cce0; --border-soft: #d8dce8;
    --text: #1a1a2e; --text-dim: #6a6a88; --text-more-dim: #9a9ab0;
    --shadow: rgba(80, 80, 120, 0.15); --canvas-bg: #f8f9ff;
  }
  body[data-theme="neon"] {
    --bg-main: #050510; --bg-deep: #030308; --bg-card: #0e0e22; --bg-card-light: #15152e;
    --bg-input: #05050e; --border: #2a2a55; --border-soft: #1a1a3a;
    --text: #e8e8ff; --text-dim: #8888bb; --text-more-dim: #555577;
    --shadow: rgba(0, 0, 0, 0.6); --canvas-bg: #02020a;
  }
  html, body { height: 100%; overflow: hidden; background: var(--bg-main); color: var(--text);
    font-family: system-ui, -apple-system, sans-serif; user-select: none; -webkit-user-select: none;
    touch-action: none; transition: background 0.4s, color 0.4s; }
  body { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 10px; }

  @keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes popIn { 0% { opacity: 0; transform: scale(0.85); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes walletPulse { 0% { transform: scale(1); } 50% { transform: scale(1.18); } 100% { transform: scale(1); } }
  @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-8px); } 75% { transform: translateX(8px); } }
  @keyframes victoryGlow { 0%, 100% { box-shadow: 0 0 30px var(--accent); } 50% { box-shadow: 0 0 60px var(--accent), 0 0 90px var(--accent); } }
  @keyframes pulse { 0%, 100% { box-shadow: 0 4px 16px rgba(251, 191, 36, 0.4); } 50% { box-shadow: 0 4px 16px rgba(251, 191, 36, 0.4), 0 0 0 8px rgba(251, 191, 36, 0.15); } }
  @keyframes toastIn { from { opacity: 0; transform: translate(-50%, 20px); } to { opacity: 1; transform: translate(-50%, 0); } }
  @keyframes wobble { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 75% { transform: rotate(12deg); } }
  @keyframes bannerPulse { 0%, 100% { transform: translateX(-50%) scale(1); } 50% { transform: translateX(-50%) scale(1.06); } }
  @keyframes chestShake { 0%, 100% { transform: translateX(0) rotate(0); } 20% { transform: translateX(-6px) rotate(-4deg); } 40% { transform: translateX(6px) rotate(4deg); } 60% { transform: translateX(-6px) rotate(-4deg); } 80% { transform: translateX(6px) rotate(4deg); } }
  @keyframes chestBurst { 0% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.6); opacity: 1; } 100% { transform: scale(2.4); opacity: 0; } }
  @keyframes prizeIn { 0% { transform: scale(0) rotate(-180deg); opacity: 0; } 60% { transform: scale(1.25) rotate(10deg); opacity: 1; } 100% { transform: scale(1) rotate(0); opacity: 1; } }
  @keyframes legendGlow { 0%, 100% { text-shadow: 0 0 20px #fbbf24, 0 0 40px #fbbf24; } 50% { text-shadow: 0 0 40px #fbbf24, 0 0 80px #fbbf24, 0 0 100px #fbbf24; } }
  @keyframes reelSpin { 0% { transform: translateY(0); } 50% { transform: translateY(-6px); } 100% { transform: translateY(0); } }
  @keyframes reelWin { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.18); } }
  .wallet-pulse { animation: walletPulse 0.4s ease-out; }
  .shake { animation: shake 0.3s; }
  .victory-glow { animation: victoryGlow 1.2s infinite !important; }

  #top { width: 100%; max-width: 500px; display: flex; justify-content: space-between;
    align-items: center; margin-bottom: 10px; gap: 6px; animation: slideDown 0.4s ease-out; }
  #title { font-size: 20px; font-weight: 800; letter-spacing: 3px;
    background: linear-gradient(135deg, var(--accent), #22d3ee 60%, #a855f7);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    cursor: pointer; filter: drop-shadow(0 0 8px var(--accent)); }
  #scoreBox { display: flex; align-items: center; gap: 5px; }
  #wallet { font-size: 15px; color: #fbbf24; font-weight: 800;
    background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    padding: 6px 11px; border-radius: 12px; border: 2px solid var(--border);
    box-shadow: 0 2px 10px var(--shadow); letter-spacing: 0.5px;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.5); transition: all 0.3s; }
  .iconBtn { background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); font-size: 15px; cursor: pointer;
    padding: 6px 8px; border-radius: 12px; filter: grayscale(100%);
    box-shadow: 0 2px 10px var(--shadow); transition: all 0.15s; color: var(--text); }
  .iconBtn:active { transform: scale(0.92); }
  .iconBtn.on { filter: grayscale(0%); }

  #bars { width: 100%; max-width: 500px; display: flex; flex-direction: column;
    gap: 8px; margin-bottom: 10px; animation: slideDown 0.5s ease-out 0.05s backwards; }
  .barRow { display: flex; align-items: center; gap: 8px; }
  .barBtn { flex: 1; padding: 12px 14px;
    background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 14px; color: var(--accent);
    font-size: 14px; font-weight: 700; cursor: pointer; text-align: left;
    letter-spacing: 0.5px; transition: all 0.15s;
    box-shadow: 0 3px 10px var(--shadow); }
  .barBtn:active { background: linear-gradient(135deg, var(--border), var(--bg-card-light));
    transform: scale(0.97); box-shadow: 0 0 16px var(--accent); }
  #openShop { background: linear-gradient(135deg, #4c1d95, #7c3aed); color: #e9d5ff; border-color: #a78bfa; }
  #openCasinoBtn { background: linear-gradient(135deg, #7f1d1d, #dc2626); color: #fff; border-color: #f59e0b; font-weight: 800; }
  #playPause { width: 46px; height: 44px;
    background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 14px; color: var(--accent);
    font-size: 18px; cursor: pointer; flex-shrink: 0; transition: all 0.15s;
    box-shadow: 0 3px 10px var(--shadow); }
  #playPause:active { background: var(--border); transform: scale(0.93); }

  #modeBar { width: 100%; max-width: 500px; display: flex; gap: 6px; margin-bottom: 10px;
    padding: 5px; background: linear-gradient(135deg, var(--bg-deep), var(--bg-main));
    border-radius: 16px; border: 1px solid var(--border-soft);
    box-shadow: 0 4px 14px var(--shadow); animation: slideDown 0.5s ease-out 0.1s backwards; }
  .modeBtn { flex: 1; padding: 10px 6px; background: transparent;
    border: 2px solid transparent; border-radius: 12px; color: var(--text-dim);
    font-size: 11px; font-weight: 800; cursor: pointer; letter-spacing: 0.3px; transition: all 0.2s; }
  .modeBtn:active { transform: scale(0.95); }
  #modeNormal.active { background: linear-gradient(135deg, #065f46, #10b981); color: #fff;
    border-color: #34d399; box-shadow: 0 0 20px rgba(52, 211, 153, 0.55); }
  #modeSprint.active { background: linear-gradient(135deg, #b45309, #f59e0b); color: #fff;
    border-color: #fbbf24; box-shadow: 0 0 20px rgba(251, 191, 36, 0.55); }
  #modeMarathon.active { background: linear-gradient(135deg, #6d28d9, #a855f7); color: #fff;
    border-color: #c084fc; box-shadow: 0 0 20px rgba(192, 132, 252, 0.55); }

  #gameWrap { position: relative; width: 100%; max-width: 500px; aspect-ratio: 1 / 1;
    animation: fadeIn 0.6s ease-out 0.15s backwards; }
  canvas { background: var(--canvas-bg); border-radius: 14px;
    box-shadow: 0 0 30px var(--accent); width: 100%; height: 100%; display: block;
    touch-action: none; transition: background 0.4s, box-shadow 0.4s; }
  #eventBanner { position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
    padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 800;
    pointer-events: none; display: none; z-index: 5; letter-spacing: 0.5px;
    text-align: center; white-space: nowrap; }
  #eventBanner.show { display: block; animation: bannerPulse 0.7s infinite; }
  #eventBanner.fever { background: linear-gradient(135deg, #f97316, #ef4444); color: #fff;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.7); }
  #eventBanner.golden { background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #1a1a2e;
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.7); }

  #overlay { position: absolute; inset: 0; display: none; flex-direction: column;
    align-items: center; justify-content: center; gap: 16px;
    background: rgba(0, 0, 0, 0.9); border-radius: 14px; text-align: center; padding: 20px; }
  #overlay.show { display: flex; animation: popIn 0.35s ease-out; }
  #overlayText { font-size: 17px; line-height: 1.6; color: #eee; }
  button.action { padding: 14px 28px; font-size: 17px;
    background: linear-gradient(135deg, var(--accent), #22c55e); color: #0f0f1e;
    border: none; border-radius: 12px; cursor: pointer; font-weight: 800;
    letter-spacing: 1px; box-shadow: 0 4px 14px var(--accent); transition: all 0.15s; }
  button.action:active { transform: scale(0.95); }

  .modal { position: fixed; inset: 0; display: none; flex-direction: column;
    background: linear-gradient(180deg, var(--bg-main), var(--bg-deep));
    z-index: 100; padding: 14px; overflow-y: auto; }
  .modal.show { display: flex; animation: fadeIn 0.25s ease-out; }
  .modalHeader { display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px; padding-bottom: 12px; border-bottom: 2px solid var(--bg-card); }
  .modalTitle { font-size: 20px; font-weight: 800; letter-spacing: 2px;
    background: linear-gradient(135deg, var(--accent), #22d3ee);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .modalClose { background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); color: var(--text); font-size: 18px;
    width: 42px; height: 42px; border-radius: 12px; cursor: pointer; font-weight: 700; }
  .modalClose:active { background: var(--border); transform: scale(0.93); }

  #shopWallet { font-size: 15px; color: #fbbf24; font-weight: 800;
    background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    padding: 6px 12px; border-radius: 12px; border: 2px solid var(--border);
    margin-right: 8px; text-shadow: 0 0 8px rgba(251, 191, 36, 0.5); }
  #dailyBtn { width: 100%; padding: 13px; margin-bottom: 12px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b); border: none;
    border-radius: 14px; color: #1a1a2e; font-size: 15px; font-weight: 800;
    cursor: pointer; letter-spacing: 0.8px;
    box-shadow: 0 4px 16px rgba(251, 191, 36, 0.4); animation: pulse 1.5s infinite; }
  #dailyBtn.disabled { background: var(--bg-card); color: var(--text-more-dim);
    animation: none; border: 2px solid var(--border); cursor: default; box-shadow: none; }
  #shopGrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding-bottom: 20px; }
  .skinCard { background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 16px; padding: 12px;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    cursor: pointer; transition: transform 0.15s; position: relative;
    box-shadow: 0 3px 12px var(--shadow); }
  .skinCard:active { transform: scale(0.96); }
  .skinCard.owned { border-color: var(--accent); }
  .skinCard.equipped { border-color: #fbbf24; box-shadow: 0 0 20px rgba(251, 191, 36, 0.5); }
  .skinCard.mythic { background: linear-gradient(135deg, #2d1b4e, #4c1d95); border-color: #c084fc; }
  .skinPreview { width: 100%; height: 65px; border-radius: 12px;
    border: 2px solid var(--bg-input); display: flex; align-items: center;
    justify-content: center; font-size: 30px; }
  .skinName { font-size: 13px; font-weight: 800; color: var(--text); text-align: center; }
  .skinStatus { font-size: 11px; font-weight: 800; padding: 4px 10px;
    border-radius: 8px; text-transform: uppercase; }
  .skinStatus.owned { background: #065f46; color: #4ade80; }
  .skinStatus.equipped { background: #fbbf24; color: #1a1a2e; }
  .skinStatus.locked { background: #7f1d1d; color: #fca5a5; }
  .skinStatus.buyable { background: #065f46; color: #a7f3d0; }
  .skinStatus.mythic { background: #7c2d12; color: #fbbf24; }
  .cardBadge { position: absolute; top: -8px; right: -8px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #1a1a2e;
    font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 20px; }
  .cardBadge.mythic { background: linear-gradient(135deg, #c084fc, #ec4899); color: #fff; }

  #passwordPrompt { position: fixed; inset: 0; display: none;
    align-items: center; justify-content: center;
    background: rgba(0, 0, 0, 0.88); z-index: 250; padding: 20px; }
  #passwordPrompt.show { display: flex; }
  #passwordBox { background: linear-gradient(160deg, var(--bg-main), var(--bg-deep));
    border: 2px solid #dc2626; border-radius: 18px; padding: 24px;
    max-width: 340px; width: 100%; text-align: center;
    box-shadow: 0 0 50px rgba(220, 38, 38, 0.5); animation: popIn 0.25s ease-out; }
  #passwordBox h2 { font-size: 18px; color: #dc2626; margin-bottom: 8px; letter-spacing: 1.5px; font-weight: 800; }
  #passwordBox p { font-size: 13px; color: var(--text-dim); margin-bottom: 16px; }
  #passwordInput { width: 100%; padding: 14px; font-size: 20px; text-align: center;
    letter-spacing: 8px; background: var(--bg-input); border: 2px solid var(--border);
    border-radius: 12px; color: var(--accent); font-family: monospace;
    outline: none; margin-bottom: 12px; }
  #passwordInput:focus { border-color: #dc2626; box-shadow: 0 0 16px rgba(220, 38, 38, 0.4); }
  #passwordError { color: #f87171; font-size: 13px; font-weight: 700; min-height: 18px; margin-bottom: 8px; }
  .pwdBtnRow { display: flex; gap: 8px; }
  .pwdBtn { flex: 1; padding: 12px; border-radius: 12px; font-size: 15px;
    font-weight: 800; cursor: pointer; border: none; }
  .pwdBtn.ok { background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; }
  .pwdBtn.cancel { background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    color: var(--text); border: 2px solid var(--border); }

  #admin { position: fixed; inset: 0; display: none; flex-direction: column;
    background: rgba(0, 0, 0, 0.98); z-index: 200; padding: 20px; overflow-y: auto; }
  #admin.show { display: flex; animation: fadeIn 0.25s ease-out; }
  #adminHeader { display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #dc2626; }
  #adminTitle { font-size: 20px; font-weight: 800; letter-spacing: 2px; color: #dc2626;
    text-shadow: 0 0 12px rgba(220, 38, 38, 0.5); }
  #closeAdmin { background: linear-gradient(135deg, #dc2626, #b91c1c);
    border: none; color: #fff; font-size: 18px; width: 42px; height: 42px;
    border-radius: 12px; cursor: pointer; font-weight: 700; }
  .adminSection { background: linear-gradient(135deg, var(--bg-main), var(--bg-deep));
    border: 2px solid var(--border); border-radius: 14px; padding: 16px; margin-bottom: 14px; }
  .adminSection h3 { font-size: 14px; color: #fbbf24; margin-bottom: 12px;
    letter-spacing: 1px; text-transform: uppercase; }
  .adminBtnRow { display: flex; gap: 8px; flex-wrap: wrap; }
  .adminBtn { flex: 1; min-width: 70px; padding: 12px;
    background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 12px; color: var(--text);
    font-size: 15px; font-weight: 700; cursor: pointer; }
  .adminBtn:active { background: var(--border); transform: scale(0.96); }
  .adminBtn.plus { color: #4ade80; border-color: #065f46; }
  .adminBtn.minus { color: #f87171; border-color: #7f1d1d; }
  .adminBtn.danger { color: #dc2626; border-color: #dc2626; }
  .adminBtn.gold { color: #fbbf24; border-color: #fbbf24; }
  .adminInfo { font-size: 14px; color: var(--text-dim); margin-bottom: 12px;
    padding: 12px; background: var(--bg-card); border-radius: 10px; }
  .adminInfo b { color: var(--accent); }

  .hueSlider { width: 100%; height: 32px; -webkit-appearance: none; appearance: none;
    background: linear-gradient(to right, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
    border-radius: 16px; outline: none; margin: 10px 0; cursor: pointer;
    border: 2px solid var(--border); }
  .hueSlider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none;
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--bg-card); border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.6); cursor: pointer; }
  .hueSlider::-moz-range-thumb { width: 32px; height: 32px; border-radius: 50%;
    background: var(--bg-card); border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.6); cursor: pointer; }
  .colorPreview { display: flex; align-items: center; gap: 12px; margin-top: 10px; }
  .colorSwatch { width: 44px; height: 44px; border-radius: 12px;
    border: 2px solid var(--border); box-shadow: 0 0 12px var(--accent); }

  #toast { position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%);
    background: linear-gradient(135deg, var(--accent), #22c55e); color: #1a1a2e;
    padding: 12px 24px; border-radius: 14px; font-weight: 800; font-size: 15px;
    z-index: 300; display: none; box-shadow: 0 4px 20px var(--accent);
    letter-spacing: 0.5px; text-align: center; max-width: 90%; }
  #toast.show { display: block; animation: toastIn 0.3s ease-out; }

  #pad { margin-top: 12px; display: grid;
    grid-template-columns: repeat(3, 62px);
    grid-template-rows: repeat(2, 62px);
    gap: 8px; justify-content: center;
    animation: slideUp 0.5s ease-out 0.2s backwards; }
  .btn { background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 16px; color: var(--accent);
    font-size: 24px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; user-select: none; box-shadow: 0 3px 10px var(--shadow);
    transition: all 0.1s; }
  .btn:active { background: linear-gradient(135deg, var(--accent), #22c55e);
    color: #0f0f1e; transform: scale(0.93); box-shadow: 0 0 20px var(--accent); }
  #up { grid-column: 2; grid-row: 1; }
  #left { grid-column: 1; grid-row: 2; }
  #down { grid-column: 2; grid-row: 2; }
  #right { grid-column: 3; grid-row: 2; }
  #hint { margin-top: 8px; font-size: 11px; color: var(--text-more-dim);
    text-align: center; animation: slideUp 0.5s ease-out 0.25s backwards; }

  .statRow { display: flex; justify-content: space-between; padding: 12px 14px;
    background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 12px; margin-bottom: 8px; font-size: 14px; }
  .statRow span:first-child { color: var(--text-dim); }
  .statRow span:last-child { color: var(--accent); font-weight: 800; }

  .achieveItem { display: flex; align-items: center; gap: 12px; padding: 12px;
    background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 12px; margin-bottom: 8px; }
  .achieveItem.done { border-color: #fbbf24; box-shadow: 0 0 16px rgba(251, 191, 36, 0.3); }
  .achieveIcon { font-size: 26px; flex-shrink: 0; width: 36px; text-align: center; }
  .achieveItem.done .achieveIcon { animation: wobble 0.6s; }
  .achieveText { flex: 1; }
  .achieveText .name { font-size: 14px; font-weight: 800; color: var(--text); }
  .achieveText .desc { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
  .achieveCheck { font-size: 20px; color: #fbbf24; }

  .goalCard { background: linear-gradient(135deg, var(--bg-card-light), var(--bg-card));
    border: 2px solid var(--border); border-radius: 14px; padding: 16px; margin-bottom: 14px; }
  .goalCard .goalTitle { font-size: 14px; color: var(--text-dim); margin-bottom: 4px; }
  .goalCard .goalDesc { font-size: 18px; font-weight: 800; color: var(--text); margin-bottom: 10px; }
  .goalBar { height: 14px; background: var(--bg-input); border-radius: 7px;
    overflow: hidden; margin-bottom: 8px; border: 1px solid var(--border); }
  .goalBarFill { height: 100%; background: linear-gradient(90deg, #4ade80, #22d3ee);
    width: 0; transition: width 0.4s; }
  .goalReward { font-size: 14px; color: #fbbf24; font-weight: 800; }
  .goalDone { text-align: center; padding: 10px; color: #4ade80; font-weight: 800; font-size: 16px; }

  #wheelWrap { position: relative; width: 280px; height: 280px;
    margin: 20px auto; display: flex; align-items: center; justify-content: center; }
